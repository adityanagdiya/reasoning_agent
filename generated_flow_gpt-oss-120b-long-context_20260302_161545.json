            "title": "Logic",
            "configData": {
               "label": "Compute MD5",
               "notes": null,
               "incomingSockets": "inp",
               "outgoingSockets": "out",
               "logic": "import java.security.MessageDigest\n\ndef joke = inp.value\nMessageDigest md = MessageDigest.getInstance(\"MD5\")\nmd.update(joke.getBytes(\"UTF-8\"))\nbyte[] digest = md.digest()\nString hash = digest.collect { String.format('%02x', it) }.join()\nout = hash",
